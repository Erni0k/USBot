# Adres API widziany z przeglądarki. Puste = ten sam origin (/api) — w trybie dev żądania
# przechodzą przez proxy Vite, w produkcji przez reverse proxy przed stroną.
# Inny origin (np. https://api.example.pl) wymaga API_CORS_ORIGINS po stronie API.
VITE_API_BASE_URL=

# Tylko `npm run dev` / `npm run preview`: dokąd proxy przekazuje /api.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# Oceny 👍/👎 (POST /api/feedback). false = przyciski widoczne, ale wyłączone.
VITE_FEEDBACK_ENABLED=true
