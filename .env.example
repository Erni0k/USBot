# --- Postgres ---
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=changeme
POSTGRES_DB=chatbot
# Lokalnie (skrypt ingestii uruchamiany na hoście):
DATABASE_URL=postgresql://chatbot:changeme@localhost:5433/chatbot

# --- Serwer modelu (Ollama domyslnie; vLLM tez OK, oba maja API OpenAI) ---
LLM_BASE_URL=http://127.0.0.1:11434/v1   # Ollama; vLLM: http://127.0.0.1:8000/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen3:8b                        # dla slabszego sprzetu: qwen3:4b / qwen3:1.7b
# 127.0.0.1, nie localhost: na Windows localhost dokleja ~2 s do kazdego pytania (proba IPv6)
# Ollama ignoruje ENABLE_THINKING - rozumowanie Qwen3 wylacza dopiero LLM_REASONING_EFFORT=none
# (nie ustawiaj dla vLLM). Pomiar: docs/api.md (3.2)
# LLM_REASONING_EFFORT=none
LLM_TIMEOUT=60                            # s: polaczenie i kazdy kolejny fragment odpowiedzi

# --- Embeddingi ---
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024       # tylko informacyjnie: wymiar wynika z modelu i infra/init.sql

# --- RAG ---
TOP_K=8
MAX_DISTANCE=0.43    # fragmenty dalsze (odl. kosinusowa) sa odrzucane; brak fragmentow = odpowiedz bez LLM
MAX_PER_URL=2        # najwyzej tyle fragmentow z jednej strony w kontekscie; 0 = bez limitu
RETRIEVAL_MODE=vector  # vector | hybrid (wektorowe + pelnotekstowe, RRF); porownanie: docs/testy.md
ENABLE_THINKING=false

# --- API HTTP (uvicorn usbot.api.main:app) ---
API_HISTORY_TURNS=5     # ile ostatnich tur historii klienta trafia do ChatService
# domena frontendu, np. https://czat.us.edu.pl; bez * i ukosnika; puste = bez CORS
API_CORS_ORIGINS=
DB_POOL_MIN=1
DB_POOL_MAX=4
DB_TIMEOUT=10           # s: polaczenie z puli, nawiazanie polaczenia, jedno zapytanie
HEALTH_TIMEOUT=3        # s: jedno sprawdzenie w /api/health
API_MAX_MESSAGE_CHARS=2000
API_MAX_HISTORY_MESSAGES=40
API_MAX_HISTORY_CHARS=40000
API_MAX_BODY_BYTES=262144
API_RATE_LIMIT_CHAT=10/minute;200/day   # na adres IP (za proxy: uvicorn --proxy-headers)
API_RATE_LIMIT_FEEDBACK=10/minute;200/day   # POST /api/feedback, na adres IP
FEEDBACK_RETENTION_DAYS=30    # po tylu dniach z tabeli feedback znikają treści (ocena zostaje)
API_RATE_LIMIT_DEFAULT=60/minute
API_RATE_LIMIT_STORAGE=memory://        # kilka procesow/instancji: redis://host:6379
API_MAX_STREAMS=4                       # rownolegle odpowiedzi w sumie
API_MAX_STREAMS_PER_CLIENT=2            # ... i z jednego adresu IP
API_DOCS=false                          # true = /docs (tylko lokalnie)
API_HSTS_SECONDS=0                      # np. 31536000 za HTTPS

# --- Dziennik rozmow (bez IP; opis: docs/architektura.md 2.4) ---
CHAT_LOG_ENABLED=true
CHAT_LOG_DIR=logs
CHAT_LOG_RETENTION_DAYS=30

# --- Crawler / ingestia ---
CRAWL_LIMIT=6000        # maks. liczba stron na jeden przebieg
CRAWL_DEPTH=3           # glebokosc BFS (0 = tylko sitemap + seedy)
CRAWL_WORKERS=6         # rownolegle requesty HTTP
EMBED_BATCH=16          # ile stron embedowac naraz
CRAWL_FRESH=false       # true = pelny re-crawl (czysci chunks i pages)
CRAWL_REFETCH=false     # true (jednorazowo) = pobierz wszystko od nowa, embeduj tylko zmienione
BOILERPLATE_URLS=20     # ta sama tresc fragmentu na >20 stronach = boilerplate, nie trafia do bazy

# =====================================================================================
# --- Wdrożenie: docker compose -f compose.prod.yml up -d --build  (docs/uruchomienie.md 4.5)
# Wartości powyżej też obowiązują w kontenerach, poza adresami: DATABASE_URL, LLM_BASE_URL,
# LLM_MODEL i LLM_REASONING_EFFORT ustawia compose.prod.yml (db:5432, llm:8000, „qwen3”).
# Sekrety są tylko w tym pliku na serwerze — nie trafiają do obrazów (.dockerignore).
# Puste wartości zostawiaj bez komentarza w tej samej linii (compose wziąłby komentarz jako wartość).
# POSTGRES_PASSWORD: zmień z changeme, bez znaków @ : / ? # (trafia do DATABASE_URL).
# =====================================================================================
SITE_ADDRESS=localhost        # domena, np. czat.us.edu.pl (TLS z Let's Encrypt); localhost = cert. lokalny
HSTS_MAX_AGE=31536000         # 0 przy testach na localhost
TZ=Europe/Warsaw              # strefa harmonogramów ingestii i kopii zapasowych

# vLLM — model dobierz do pamięci GPU (tabela: docs/uruchomienie.md 4.5).
# Obok vLLM na tej samej karcie: bge-m3 w API (~2,5 GB) i w czasie ingestii drugi (~2,5 GB).
VLLM_IMAGE_TAG=v0.33.0
VLLM_MODEL=Qwen/Qwen3-8B-AWQ  # 24 GB; 10-12 GB: Qwen/Qwen3-4B-AWQ; >=40 GB: Qwen/Qwen3-8B
VLLM_GPU_MEMORY_UTILIZATION=0.6   # ułamek CAŁEJ pamięci GPU dla vLLM (wagi + KV cache)
VLLM_MAX_MODEL_LEN=8192       # prompt (TOP_K fragmentów + historia) + odpowiedź, w tokenach
# opcjonalnie: szybsze pobieranie z Hugging Face
HF_TOKEN=

# Ingestia (usługa ingest): składnia cron, czas TZ; tylko jeden przebieg naraz
INGEST_SCHEDULE="0 3 * * 1-6"         # przyrostowo: codziennie o 3:00 poza niedzielą
INGEST_REFETCH_SCHEDULE="0 3 * * 0"   # CRAWL_REFETCH=true: w niedzielę o 3:00
INGEST_ON_EMPTY=true                  # pusta baza przy starcie → pierwszy przebieg od razu

# Kopie zapasowe (usługa backup, pg_dump do wolumenu backups)
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=3

LOG_FORMAT=text               # w kontenerach compose ustawia json
VITE_FEEDBACK_ENABLED=true    # oceny 👍/👎 (wkompilowane w stronę przy budowaniu obrazu web)
USBOT_VERSION=latest          # tag obrazów usbot-api / usbot-web (np. 2026.11.06 przy wdrożeniu)
