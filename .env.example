# --- Postgres ---
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=changeme
POSTGRES_DB=chatbot
# Lokalnie (skrypt ingestii uruchamiany na hoście):
DATABASE_URL=postgresql://chatbot:changeme@localhost:5433/chatbot

# --- Serwer modelu (vLLM lub Ollama; oba mają API zgodne z OpenAI) ---
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen3

# --- Embeddingi ---
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024

# --- RAG ---
TOP_K=5
ENABLE_THINKING=false

# --- Crawler / ingestia ---
CRAWL_LIMIT=2000        # maks. liczba stron na jeden przebieg
CRAWL_DEPTH=3           # glebokosc BFS (0 = tylko sitemap + seedy)
CRAWL_WORKERS=6         # rownolegle requesty HTTP
EMBED_BATCH=16          # ile stron embedowac naraz
CRAWL_FRESH=false       # true = pelny re-crawl (czysci chunks i pages)
